{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mockingbird world description",
  "description": "How a compiled contract behaves as a world: identities, record pointers, lifecycles, paging and the rest. Every key is optional.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "types": {
      "type": "object",
      "description": "Keyed by resource type.",
      "additionalProperties": {
        "$ref": "#/$defs/type"
      }
    },
    "operations": {
      "type": "object",
      "description": "Keyed by operation id.",
      "additionalProperties": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "member": {
      "type": "string",
      "minLength": 1,
      "description": "A dotted path to a record member, e.g. `name` or `meta.id`."
    },
    "param": {
      "type": "string",
      "minLength": 1,
      "description": "A declared request parameter, or a pointer into the request body (`/q`, `/ActiveList/Pagination/PageNumber`)."
    },
    "header": {
      "type": "string",
      "minLength": 1,
      "description": "A declared header name."
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599,
      "description": "A declared response status."
    },
    "pointer": {
      "type": "string",
      "pattern": "^(/([^~]|~[01])*)+$",
      "description": "An RFC 6901 JSON pointer, e.g. `/result/0`."
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "kind"
      ],
      "description": "An update whose request sends instructions instead of a record (a semantic patch): `at`, the request body's array of instructions; `kind`, the member of an instruction naming its kind; `kinds`, the members of the target each kind changes. A braced step of a member (`environments.{environmentKey}.on`) is the value of that member of the instruction, else of the request body.",
      "properties": {
        "at": {
          "$ref": "#/$defs/pointer"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "changes": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "from_instruction": {
                          "$ref": "#/$defs/pointer",
                          "description": "The instruction's value at this pointer."
                        }
                      },
                      "required": [
                        "from_instruction"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "from_request": {
                          "$ref": "#/$defs/pointer",
                          "description": "The request body's value at this pointer."
                        }
                      },
                      "required": [
                        "from_request"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "value": true
                      },
                      "required": [
                        "value"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "append": {
                          "$ref": "#/$defs/pointer",
                          "description": "Adds the instruction's value at this pointer (each item of an array) to the array member, once."
                        }
                      },
                      "required": [
                        "append"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "remove": {
                          "$ref": "#/$defs/pointer",
                          "description": "Removes the instruction's value at this pointer (each item of an array) from the array member."
                        }
                      },
                      "required": [
                        "remove"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "recordPointer": {
      "type": "string",
      "pattern": "^$|^(/([^~]|~[01])*)+$",
      "description": "An RFC 6901 JSON pointer to the one record, e.g. `/data`; the root pointer `\"\"` says the whole answer (or request body) is the record."
    },
    "pattern": {
      "type": "string",
      "pattern": "\\{id\\}",
      "description": "A value pattern holding exactly one `{id}`, e.g. `folders/{id}`."
    },
    "type": {
      "description": "How records of one resource type behave.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "parent": {
          "$ref": "#/$defs/parent"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "unique": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unique"
          }
        },
        "concurrency": {
          "$ref": "#/$defs/concurrency"
        },
        "derived": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/derived"
          },
          "description": "Read as `computed` members: `count` is the number of held children of `of`, `sum` the exact sum of their `member` (where they hold the `where` values)."
        },
        "computed": {
          "type": "object",
          "description": "Members computed whenever a record of the type is answered, and never stored, keyed by member path: each value an expression (a CEL subset, see docs/world.md) over `record` (the record answered), `request` and `now`.",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member": {
          "$ref": "#/$defs/member"
        },
        "pattern": {
          "$ref": "#/$defs/pattern"
        },
        "alternates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          }
        }
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "member": {
          "$ref": "#/$defs/member"
        },
        "path_param": {
          "$ref": "#/$defs/param"
        },
        "pattern": {
          "$ref": "#/$defs/pattern"
        },
        "embedded": {
          "$ref": "#/$defs/member",
          "description": "The parent's array member records of the type live in, when they are held inside their parent."
        }
      },
      "required": [
        "type"
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member": {
          "$ref": "#/$defs/member"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "initial": {
          "type": "string",
          "minLength": 1
        },
        "soft_delete": {
          "$ref": "#/$defs/soft_delete"
        }
      },
      "required": [
        "member"
      ]
    },
    "soft_delete": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "listed_with": {
          "$ref": "#/$defs/param_value"
        },
        "unless": {
          "$ref": "#/$defs/param_value"
        }
      },
      "required": [
        "state"
      ]
    },
    "param_value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "param": {
          "$ref": "#/$defs/param"
        },
        "value": true
      },
      "required": [
        "param",
        "value"
      ]
    },
    "unique": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "minItems": 1
        },
        "scope": {
          "$ref": "#/$defs/member"
        },
        "conflict": {
          "$ref": "#/$defs/status"
        }
      },
      "required": [
        "members"
      ]
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member": {
          "$ref": "#/$defs/member"
        },
        "header": {
          "$ref": "#/$defs/header"
        },
        "conflict": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "derived": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "count"
            },
            "of": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "of"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sum"
            },
            "of": {
              "type": "string",
              "minLength": 1
            },
            "member": {
              "$ref": "#/$defs/member"
            },
            "where": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "of",
            "member"
          ]
        }
      ]
    },
    "operation": {
      "description": "How one operation acts on the world.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "create",
            "read",
            "list",
            "update",
            "replace",
            "delete",
            "action"
          ]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path_param": {
              "$ref": "#/$defs/param"
            },
            "member": {
              "$ref": "#/$defs/member"
            }
          }
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "record": {
              "$ref": "#/$defs/recordPointer"
            },
            "records": {
              "$ref": "#/$defs/pointer"
            },
            "instructions": {
              "$ref": "#/$defs/instructions"
            }
          }
        },
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "record": {
              "$ref": "#/$defs/recordPointer"
            },
            "records": {
              "$ref": "#/$defs/pointer"
            },
            "long_running": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "done": {
                  "$ref": "#/$defs/member"
                },
                "result": {
                  "$ref": "#/$defs/member"
                }
              },
              "required": [
                "done",
                "result"
              ]
            },
            "identity_header": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "const": false
                }
              ]
            }
          }
        },
        "transition": {
          "type": "object"
        },
        "changes": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "from_request": {
                    "$ref": "#/$defs/pointer"
                  }
                },
                "required": [
                  "from_request"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": true
                },
                "required": [
                  "value"
                ]
              }
            ]
          },
          "description": "Read as `set` entries: `from_request` is the expression reading the request body there, `value` a literal."
        },
        "set": {
          "type": "object",
          "description": "Members of the record a create, update, replace or action stores, keyed by member path: each value an expression (a CEL subset, see docs/world.md) over `request`, `record` and `now`.",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "refuse": {
          "type": "array",
          "description": "Refusals checked in order before anything is stored or generated: the first whose `when` is true answers its declared `status`, with `code` and `message` placed in the members its error schema has for them (text as written, or `{expr}`).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "when": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "code": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "expr": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "expr"
                    ]
                  }
                ]
              },
              "message": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "expr": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "expr"
                    ]
                  }
                ]
              }
            },
            "required": [
              "when",
              "status"
            ]
          }
        },
        "effects": {
          "type": "array",
          "maxItems": 8,
          "description": "Writes to other records, in order, after the operation's own write of its target and only when it happened: `create` a record of `type` with `set`, `update` the held record `id` names with `set`, `delete` it; `when` must be true. In `set` and `when`, `record` is the target as written and `it` the record an update or delete finds. Effects do not cascade.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "enum": [
                  "create",
                  "update",
                  "delete"
                ]
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "set": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "when": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "type"
            ]
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "param": {
              "$ref": "#/$defs/param"
            },
            "member": {
              "$ref": "#/$defs/member",
              "description": "The record member the parameter's value matches. Absent when the parameter is a value a create of the records' `parent` type issues (an issued alternate): the list holds that parent's records."
            },
            "kind": {
              "enum": [
                "eq",
                "prefix"
              ],
              "description": "`eq` (the default): the member holds the parameter's value; `prefix`: the member is a path directly under the parameter's."
            },
            "recursive": {
              "$ref": "#/$defs/param",
              "description": "With `kind: prefix`, the parameter whose `true` asks for every record below the path."
            }
          },
          "required": [
            "param"
          ]
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "param": {
                "$ref": "#/$defs/param"
              },
              "member": {
                "$ref": "#/$defs/member"
              },
              "kind": {
                "enum": [
                  "eq",
                  "contains",
                  "gte",
                  "lte",
                  "flag",
                  "text"
                ]
              },
              "grammar": {
                "enum": [
                  "scim",
                  "odata",
                  "field_value",
                  "deep_object"
                ]
              },
              "member_prefix": {
                "$ref": "#/$defs/member"
              }
            },
            "required": [
              "param"
            ],
            "oneOf": [
              {
                "required": [
                  "kind"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "grammar"
                      ]
                    },
                    {
                      "required": [
                        "member_prefix"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "grammar"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "kind"
                      ]
                    },
                    {
                      "required": [
                        "member"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        "order": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "member": {
              "$ref": "#/$defs/member"
            },
            "descending": {
              "type": "boolean"
            }
          },
          "required": [
            "member"
          ]
        },
        "list": {
          "type": "object",
          "additionalProperties": false,
          "description": "A list's expressions (a CEL subset, see docs/world.md). `where`: the default item filter, `it` bound to each record as stored; only records it is true for are listed, before paging, scope, filters and order. `sort`: when the request sends `param`, `by` (with `value` bound to the parameter as sent) gives `[{member, desc?}]`, the members to order the items by in turn.",
          "properties": {
            "where": {
              "type": "string",
              "minLength": 1
            },
            "sort": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "param": {
                  "$ref": "#/$defs/param"
                },
                "by": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "param",
                "by"
              ]
            }
          }
        },
        "paging": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": {
              "enum": [
                "cursor",
                "page",
                "offset",
                "next_url",
                "header_cursor"
              ]
            },
            "request": {
              "$ref": "#/$defs/param"
            },
            "response": {
              "$ref": "#/$defs/member"
            },
            "response_header": {
              "$ref": "#/$defs/header"
            },
            "size": {
              "$ref": "#/$defs/param"
            }
          },
          "required": [
            "style"
          ]
        },
        "ignores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/param"
          },
          "description": "Request parameters (or body pointers) that ask nothing of a list's items, e.g. an API version."
        },
        "idempotency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "header": {
              "$ref": "#/$defs/header"
            }
          },
          "required": [
            "header"
          ]
        },
        "not_found": {
          "$ref": "#/$defs/status"
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "param": {
              "$ref": "#/$defs/param"
            },
            "separator": {
              "type": "string",
              "minLength": 1
            },
            "always": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/member"
              }
            },
            "default": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/member"
              }
            }
          },
          "required": [
            "param"
          ]
        },
        "queue": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "effect": {
              "enum": [
                "append",
                "take"
              ]
            },
            "count": {
              "$ref": "#/$defs/pointer"
            },
            "requeue": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "at": {
                  "$ref": "#/$defs/pointer"
                },
                "value": true
              },
              "required": [
                "at",
                "value"
              ]
            },
            "redelivered": {
              "$ref": "#/$defs/member"
            }
          },
          "required": [
            "effect"
          ]
        }
      }
    }
  }
}
