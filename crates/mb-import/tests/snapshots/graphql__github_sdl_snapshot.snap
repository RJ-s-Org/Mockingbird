protocol_payload:
  graphql:
    sdl: "# A GitHub-like subset of the GitHub GraphQL API, used as an importer fixture.\n\n\"\"\"An object with an ID.\"\"\"\ninterface Node {\n  \"\"\"ID of the object.\"\"\"\n  id: ID!\n}\n\n\"\"\"An ISO-8601 encoded UTC date string.\"\"\"\nscalar DateTime\n\n\"\"\"The possible states of an issue.\"\"\"\nenum IssueState {\n  \"\"\"An issue that is still open.\"\"\"\n  OPEN\n  \"\"\"An issue that has been closed.\"\"\"\n  CLOSED\n}\n\n\"\"\"A user is an individual's account on GitHub.\"\"\"\ntype User implements Node {\n  id: ID!\n  \"\"\"The username used to login.\"\"\"\n  login: String!\n  \"\"\"The user's public profile name.\"\"\"\n  name: String\n  createdAt: DateTime!\n  \"\"\"A list of repositories that the user owns.\"\"\"\n  repositories(first: Int = 10): [Repository!]!\n}\n\n\"\"\"A repository contains the content for a project.\"\"\"\ntype Repository implements Node {\n  id: ID!\n  \"\"\"The name of the repository.\"\"\"\n  name: String!\n  \"\"\"The User owner of the repository.\"\"\"\n  owner: User!\n  \"\"\"Identifies if the repository is private.\"\"\"\n  isPrivate: Boolean!\n  \"\"\"The number of stars.\"\"\"\n  stargazerCount: Int!\n  \"\"\"A list of issues that have been opened in the repository.\"\"\"\n  issues(states: [IssueState!], first: Int): [Issue!]!\n}\n\n\"\"\"An Issue is a place to discuss ideas, enhancements, tasks, and bugs.\"\"\"\ntype Issue implements Node @key(fields: \"id\") {\n  id: ID!\n  \"\"\"Identifies the issue number.\"\"\"\n  number: Int!\n  \"\"\"Identifies the issue title.\"\"\"\n  title: String!\n  \"\"\"Identifies the body of the issue.\"\"\"\n  body: String\n  \"\"\"Identifies the state of the issue.\"\"\"\n  state: IssueState!\n  author: User\n  repository: Repository!\n  createdAt: DateTime!\n}\n\nextend type Issue {\n  \"\"\"Identifies the labels of the issue.\"\"\"\n  labels: [String!]!\n}\n\n\"\"\"The results of a search.\"\"\"\nunion SearchResult = Repository | Issue | User\n\n\"\"\"Autogenerated input type of CreateIssue.\"\"\"\ninput CreateIssueInput {\n  \"\"\"The Node ID of the repository.\"\"\"\n  repositoryId: ID!\n  \"\"\"The title for the issue.\"\"\"\n  title: String!\n  \"\"\"The body for the issue description.\"\"\"\n  body: String\n  \"\"\"Labels to apply to the issue.\"\"\"\n  labels: [String!] = []\n}\n\n\"\"\"The query root of GitHub's GraphQL interface.\"\"\"\ntype Query {\n  \"\"\"The currently authenticated user.\"\"\"\n  viewer: User!\n  \"\"\"Lookup a given repository by the owner and repository name.\"\"\"\n  repository(owner: String!, name: String!): Repository\n  \"\"\"Lookup an issue by its Node ID.\"\"\"\n  issue(id: ID!): Issue\n  \"\"\"Perform a search across resources.\"\"\"\n  search(query: String!, first: Int = 10): [SearchResult!]!\n}\n\n\"\"\"The root query for implementing GraphQL mutations.\"\"\"\ntype Mutation {\n  \"\"\"Creates a new issue.\"\"\"\n  createIssue(input: CreateIssueInput!): Issue\n  \"\"\"Updates an Issue.\"\"\"\n  updateIssue(id: ID!, input: CreateIssueInput!): Issue\n  \"\"\"Deletes an Issue object.\"\"\"\n  deleteIssue(id: ID!): Issue\n}\n\n\"\"\"The root subscription type.\"\"\"\ntype Subscription {\n  \"\"\"Emitted when an issue is opened in a repository.\"\"\"\n  issueAdded(repositoryId: ID!): Issue!\n}\n"
